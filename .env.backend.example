# Copie para .env.backend no servidor. Nunca envie .env.backend ao Git.
AUTOBLOG_SITE_URL=https://achadoagora.blog.br
AUTOBLOG_PUBLIC_SEARCH_ORIGINS=https://achadoagora.blog.br,https://www.achadoagora.blog.br

# Necessaria para buscar lojas e gerar lmdee.link sem depender de login grafico.
AUTOBLOG_LOMADEE_API_KEY=

# Token de um Cloudflare Tunnel gerenciado remotamente. Use apenas com o perfil tunnel.
TUNNEL_TOKEN=
