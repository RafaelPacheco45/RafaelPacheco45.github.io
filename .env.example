AUTOBLOG_HOST=127.0.0.1
AUTOBLOG_PORT=4177

# Optional. Leave empty to autodetect Chrome/Edge on Windows.
AUTOBLOG_CHROME_PATH=

# Persistent browser profile used by Playwright and manual login.
AUTOBLOG_CHROME_PROFILE=./data/chrome-profile

# Opened by `npm run login`.
AUTOBLOG_LOGIN_TARGETS=mercadolivre,gemini,facebook

# Public site base URL used by sitemap and generated links after deploy.
AUTOBLOG_SITE_URL=https://seu-dominio.com.br

# Public search gateway. Keep it bound to localhost and expose only this port
# through a trusted HTTPS tunnel/reverse proxy.
AUTOBLOG_PUBLIC_SEARCH_HOST=127.0.0.1
AUTOBLOG_PUBLIC_SEARCH_PORT=4178
AUTOBLOG_PUBLIC_SEARCH_ORIGINS=https://seu-dominio.com.br
AUTOBLOG_PUBLIC_SEARCH_RATE_LIMIT=6
AUTOBLOG_PUBLIC_SEARCH_RATE_WINDOW_MS=900000
AUTOBLOG_PUBLIC_SEARCH_CACHE_TTL_MS=900000
AUTOBLOG_PUBLIC_SEARCH_MAX_QUEUE=3
AUTOBLOG_PUBLIC_SEARCH_API_URL=https://api.seu-dominio.com.br

# Facebook page URL for organic post automation. Ads stay as drafts by default.
AUTOBLOG_FACEBOOK_PAGE_URL=
AUTOBLOG_FACEBOOK_ALLOW_ORGANIC_PUBLISH=0
AUTOBLOG_META_ALLOW_LIVE_ADS=0
AUTOBLOG_META_DAILY_BUDGET_CAP_BRL=20

# Gemini via browser only. If 1, content generation fails instead of using local fallback.
AUTOBLOG_GEMINI_REQUIRED=0

# Maximum products imported from one automated search by default.
AUTOBLOG_DEFAULT_SEARCH_LIMIT=5

# Lomadee/Social Soul affiliate network API key (x-api-key). Create in
# app.lomadee.com.br > perfil > Credenciais de API. Needs shortener:write scope.
AUTOBLOG_LOMADEE_API_KEY=
